{{if .build_cmd}}FROM node:{{.node_version}}-alpine AS build
WORKDIR /app
{{if .corepack}}RUN corepack enable
{{end}}COPY package*.json pnpm-lock.yaml* yarn.lock* ./
RUN {{.install_cmd}}
COPY . .
RUN {{.build_cmd}}

FROM nginx:{{.nginx_tag}}
COPY --from=build /app/{{.static_dir}} /usr/share/nginx/html
{{else}}FROM nginx:{{.nginx_tag}}
COPY {{.static_dir}} /usr/share/nginx/html
{{end}}{{if .spa}}RUN printf '%s\n' 'server {' '  listen 80;' '  root /usr/share/nginx/html;' '  index index.html;' '  location / { try_files $uri $uri/ /index.html; }' '}' > /etc/nginx/conf.d/default.conf
{{end}}EXPOSE 80
